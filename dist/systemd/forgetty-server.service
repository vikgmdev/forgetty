[Unit]
Description=Forgetty durable terminal server
Documentation=https://forgetty.dev
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/forgetty server run
Restart=on-failure
RestartSec=5s

# Logs go to the user journal. Read with: journalctl --user -u forgetty-server -f
StandardOutput=journal
StandardError=journal

# XDG_RUNTIME_DIR is set by systemd for user services.
# Panes are children of this process, so stop the whole cgroup on exit.
KillMode=control-group
# Give the server time to flush byte logs and save the layout on stop.
TimeoutStopSec=20

[Install]
WantedBy=default.target
